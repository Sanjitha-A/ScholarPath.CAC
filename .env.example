# Frontend: set to your deployed API origin for production, or leave blank for same-origin/local use.
VITE_API_URL=http://localhost:3001

# API / database configuration
NODE_ENV=development
PORT=3001
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=scholarpath_app
MYSQL_PASSWORD=
MYSQL_DATABASE=scholarpath
MYSQL_SSL=false

# Public deployment values should be stored in the host provider's secret environment settings.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_local_admin_password
SESSION_SECRET=generate_a_random_secret_at_least_32_characters
ALLOWED_ORIGINS=http://localhost:8443,https://your-frontend-domain.com
PUBLIC_FRONTEND_URL=http://localhost:8443
