{
  "name": "figma-make-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "node --env-file-if-exists=.env server.js",
    "dev:all": "concurrently \"npm run dev -- --host 0.0.0.0\" \"npm run dev:server\"",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server.js",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "preview:pages": "vite preview --host 0.0.0.0 --port 4173",
    "format": "oxfmt",
    "deploy:pages": "npm run build"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "mysql2": "^3.12.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^10.0.5",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5",
    "vitest": "^5.0.2"
  }
}
